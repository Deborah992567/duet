# EnvyChat backend local/CI environment.
# Copy to `.env` before running the API. Production secrets must be rotated.

ENVIRONMENT=development
SECRET_KEY=dev-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=10080
REFRESH_TOKEN_DAYS=90
DATABASE_URL=mysql+pymysql://envy:envy@localhost:3306/envy_chat
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
# PRESIGNED_SECRETS=s3://...   # optional object storage prefix
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=